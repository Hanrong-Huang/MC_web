{
  "name": "voxelcraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p server && tsc --noEmit -p worker && vite build",
    "build:server": "node scripts/build-server.mjs",
    "server": "npm run build && npm run build:server && node dist-server/server.mjs",
    "server:only": "npm run build:server && node dist-server/server.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^22.20.4",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.60.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.142.0"
  }
}
